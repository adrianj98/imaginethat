# Swift / Xcode
.build/
build/
DerivedData/
*.xcuserdata
*.xcworkspace
xcuserdata/

# Go
gocryptfs-lib/internal/

# Go webserver
webserver/bin/
webserver/web/node_modules/
webserver/web/*.tsbuildinfo
# The SPA builds into server/dist so go:embed can reach it. Only .gitkeep is
# committed, which is enough for `go:embed all:dist` to work without Node.
webserver/server/dist/*
!webserver/server/dist/.gitkeep

# macOS
.DS_Store
._*

# Editors
*.swp
*~
.vscode/
.idea/

# Claude
.claude/

# Android
android/app/libs/vaultcore.aar
android/**/build/
android/.gradle/
android/local.properties

# Go core
# internal/gocryptfs is generated by core/scripts/sync-gocryptfs.sh
core/internal/gocryptfs/
# Stale copy from before the Go core, when webserver/ synced its own; nothing uses it
webserver/internal/gocryptfs/
